#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";
		default_layer {
			bindings = <
				&kp TILDE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                             &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
				&kp LBKT   &kp Q   &kp W   &kp E   &kp R   &kp T                              &kp Y   &kp U   &kp I      &kp O    &kp P     &kp EQUAL
				&kp RBKT   &kp A   &kp S   &kp D   &kp F   &kp G                              &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
				&kp TAB    &kp Z   &kp X   &kp C   &kp V   &kp B      &mo 1        &kp ESC    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
				                      &kp LWIN  &kp LCTRL  &kp LSHFT  &kp SPACE    &kp SPACE  &kp RSHFT  &kp RCTRL  &kp RALT
 			>;
		};
		symbols {
			bindings = <
				&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7    &kp F8     &kp F9     &kp F10    &kp F11
				&none    &none   &none   &none   &none   &none                   &none   &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &kp BSPC
				&none    &none   &none   &none   &none   &none                   &none   &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &kp DEL
				&none    &none   &none   &none   &none   &none   &none    &none  &none   &none     &none      &none      &kp BSLH   &none
				                         &trans  &trans  &trans  &none    &none  &trans  &trans  &trans
 			>;
		};
	};
};

